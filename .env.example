# ==============================================================================
# Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to `.env` when running via `docker compose`:
#   cp .env.example .env
#
# Note: Local Python (`venv` / `pip install`) and Kubernetes runs do not require
# this file—they resolve `-f <frame_path>` directly from the filesystem or pod mount.

# Path on your host machine containing simulation frame directories.
# Mounted read-only to /app/workspace/frames inside Docker Compose containers.
# Defaults here to ./examples so the included Zimbabwe demo runs out of the box.
FRAMES_DIR=./examples

# Path to a local clone of starsimhub/stisim for editable `dev-service` runs (defaults to ../stisim in docker-compose.yml if unset)
STISIM_REPO_PATH=../stisim

# Host directory where simulation outputs are persisted
OUTPUT_DIR=./output
